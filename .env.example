# Browser-public values only. Never put private API keys here.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_CONSULTANT_EMAIL=
VITE_CONSULTANT_NAME=Business Health Advisory
VITE_FIRM_NAME=Business Health 360
VITE_CONSULTANT_PHONE=
VITE_CONSULTANT_WEBSITE=
VITE_BOOKING_URL=
# Use full responses only after testing the actual EmailJS template/service.
VITE_EMAILJS_INCLUDE_FULL_RESPONSES=true
# Conservative UTF-8 template parameter limit; must be <= 45000.
VITE_EMAILJS_MAX_BYTES=42000
# Set if reCAPTCHA v2 is enabled on the EmailJS template.
VITE_RECAPTCHA_SITE_KEY=
